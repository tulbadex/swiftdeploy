services:
  app:
    image: {{APP_IMAGE}}
    container_name: swiftdeploy-app
    environment:
      - MODE={{MODE}}
      - APP_VERSION={{APP_VERSION}}
      - APP_PORT={{APP_PORT}}
    networks:
      - {{NETWORK_NAME}}
    restart: {{RESTART_POLICY}}
    volumes:
      - {{VOLUME_NAME}}:/app/logs
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{APP_PORT}}/healthz"]
      interval: 10s
      timeout: 3s
      start_period: 5s
      retries: 3

  nginx:
    image: {{NGINX_IMAGE}}
    container_name: swiftdeploy-nginx
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - {{VOLUME_NAME}}:/var/log/nginx
    depends_on:
      app:
        condition: service_healthy
    networks:
      - {{NETWORK_NAME}}
    restart: {{RESTART_POLICY}}
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - CHOWN
      - SETUID
      - SETGID
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true

networks:
  {{NETWORK_NAME}}:
    driver: {{NETWORK_DRIVER}}

volumes:
  {{VOLUME_NAME}}:
    name: {{VOLUME_NAME}}
