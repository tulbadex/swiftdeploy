#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$SCRIPT_DIR/manifest.yaml"
TEMPLATES_DIR="$SCRIPT_DIR/templates"
GENERATED_COMPOSE="$SCRIPT_DIR/docker-compose.yml"
GENERATED_NGINX="$SCRIPT_DIR/nginx.conf"

# ─── Colors ───
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
ok()    { echo -e "${GREEN}[PASS]${NC}  $*"; }
fail()  { echo -e "${RED}[FAIL]${NC}  $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }

# ─── Find a working Python interpreter ───
PYTHON_CMD=""
for cmd in python3 python; do
    if $cmd -c "print(1)" &>/dev/null 2>&1; then
        PYTHON_CMD="$cmd"
        break
    fi
done

# ─── YAML parser (pure bash, no yq dependency) ───
yaml_get() {
    local file="$1" key="$2"
    # Handles nested keys like services.app.port
    local IFS='.'
    read -ra parts <<< "$key"
    local indent=0
    local result=""
    local current_depth=0
    local match_depth=0
    local target_part="${parts[0]}"

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

        # Count leading spaces
        local stripped="${line#"${line%%[![:space:]]*}"}"
        local spaces=$(( ${#line} - ${#stripped} ))
        local depth=$(( spaces / 2 ))

        # Extract key and value
        if [[ "$stripped" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*):(.*)$ ]]; then
            local k="${BASH_REMATCH[1]}"
            local v="${BASH_REMATCH[2]}"
            v="${v#"${v%%[![:space:]]*}"}"  # trim leading spaces
            v="${v%"${v##*[![:space:]]}"}"  # trim trailing spaces
            # Remove surrounding quotes
            v="${v#\"}" ; v="${v%\"}"
            v="${v#\'}" ; v="${v%\'}"

            if (( depth == match_depth )) && [[ "$k" == "$target_part" ]]; then
                (( match_depth++ ))
                if (( match_depth == ${#parts[@]} )); then
                    if [[ -n "$v" ]]; then
                        echo "$v"
                        return 0
                    fi
                    # Value might be on next indented lines (not needed for this use case)
                    return 1
                fi
                target_part="${parts[$match_depth]}"
            elif (( depth < match_depth )); then
                # We've exited the block we were matching
                return 1
            fi
        fi
    done < "$file"
    return 1
}

# ─── Read manifest values ───
read_manifest() {
    APP_IMAGE=$(yaml_get "$MANIFEST" "services.image") || APP_IMAGE=""
    APP_PORT=$(yaml_get "$MANIFEST" "services.port") || APP_PORT=""
    APP_MODE=$(yaml_get "$MANIFEST" "services.mode") || APP_MODE="stable"
    APP_VERSION=$(yaml_get "$MANIFEST" "services.version") || APP_VERSION="1.0.0"
    RESTART_POLICY=$(yaml_get "$MANIFEST" "services.restart") || RESTART_POLICY="unless-stopped"
    NGINX_IMAGE=$(yaml_get "$MANIFEST" "nginx.image") || NGINX_IMAGE=""
    NGINX_PORT=$(yaml_get "$MANIFEST" "nginx.port") || NGINX_PORT=""
    PROXY_TIMEOUT=$(yaml_get "$MANIFEST" "nginx.proxy_timeout") || PROXY_TIMEOUT="30"
    CONTACT=$(yaml_get "$MANIFEST" "nginx.contact") || CONTACT="admin@swiftdeploy.local"
    NETWORK_NAME=$(yaml_get "$MANIFEST" "network.name") || NETWORK_NAME=""
    NETWORK_DRIVER=$(yaml_get "$MANIFEST" "network.driver_type") || NETWORK_DRIVER="bridge"
    VOLUME_NAME=$(yaml_get "$MANIFEST" "volumes.logs.name") || VOLUME_NAME="swiftdeploy-logs"
}

# ─── INIT ───
cmd_init() {
    info "Parsing manifest.yaml..."
    read_manifest

    info "Generating nginx.conf from template..."
    sed -e "s|{{APP_PORT}}|${APP_PORT}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{PROXY_TIMEOUT}}|${PROXY_TIMEOUT}|g" \
        -e "s|{{CONTACT}}|${CONTACT}|g" \
        "$TEMPLATES_DIR/nginx.conf.tmpl" > "$GENERATED_NGINX"

    info "Generating docker-compose.yml from template..."
    sed -e "s|{{APP_IMAGE}}|${APP_IMAGE}|g" \
        -e "s|{{APP_PORT}}|${APP_PORT}|g" \
        -e "s|{{MODE}}|${APP_MODE}|g" \
        -e "s|{{APP_VERSION}}|${APP_VERSION}|g" \
        -e "s|{{NGINX_IMAGE}}|${NGINX_IMAGE}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{NETWORK_NAME}}|${NETWORK_NAME}|g" \
        -e "s|{{NETWORK_DRIVER}}|${NETWORK_DRIVER}|g" \
        -e "s|{{RESTART_POLICY}}|${RESTART_POLICY}|g" \
        -e "s|{{VOLUME_NAME}}|${VOLUME_NAME}|g" \
        "$TEMPLATES_DIR/docker-compose.yml.tmpl" > "$GENERATED_COMPOSE"

    ok "Generated nginx.conf"
    ok "Generated docker-compose.yml"
}

# ─── VALIDATE ───
cmd_validate() {
    local errors=0

    # Check 1: manifest.yaml exists and is valid YAML
    if [[ -f "$MANIFEST" ]]; then
        local yaml_valid=true
        if [[ -n "$PYTHON_CMD" ]]; then
            if ! $PYTHON_CMD -c "
import sys
fpath = sys.argv[1]
try:
    import yaml
    with open(fpath) as f:
        yaml.safe_load(f)
except ImportError:
    with open(fpath) as f:
        content = f.read()
    if chr(9) in content:
        sys.exit(1)
    for line in content.strip().splitlines():
        s = line.lstrip()
        if s and not s.startswith('#') and ':' not in s and not s.startswith('-'):
            sys.exit(1)
except Exception:
    sys.exit(1)
" "$MANIFEST" 2>/dev/null; then
                yaml_valid=false
            fi
        else
            # Fallback: basic bash checks (no tabs in YAML)
            if grep -qP '\t' "$MANIFEST" 2>/dev/null; then
                yaml_valid=false
            fi
        fi
        if $yaml_valid; then
            ok "manifest.yaml exists and is valid YAML"
        else
            fail "manifest.yaml is not valid YAML"
            (( errors++ ))
        fi
    else
        fail "manifest.yaml does not exist"
        (( errors++ ))
    fi

    # Check 2: Required fields present and non-empty
    read_manifest
    local missing=0
    for field in APP_IMAGE APP_PORT NGINX_IMAGE NGINX_PORT NETWORK_NAME NETWORK_DRIVER; do
        val="${!field}"
        if [[ -z "$val" ]]; then
            fail "Required field missing or empty: $field"
            (( missing++ ))
        fi
    done
    if (( missing == 0 )); then
        ok "All required fields are present and non-empty"
    else
        (( errors++ ))
    fi

    # Check 3: Docker image exists locally
    if docker image inspect "$APP_IMAGE" &>/dev/null; then
        ok "Docker image '$APP_IMAGE' exists locally"
    else
        fail "Docker image '$APP_IMAGE' not found locally"
        (( errors++ ))
    fi

    # Check 4: Nginx port not already bound
    local port_in_use=false
    if command -v ss &>/dev/null; then
        ss -tlnp 2>/dev/null | grep -q ":${NGINX_PORT}\b" && port_in_use=true
    elif command -v netstat &>/dev/null; then
        netstat -tlnp 2>/dev/null | grep -q ":${NGINX_PORT}\b" && port_in_use=true
    elif command -v lsof &>/dev/null; then
        lsof -i :"${NGINX_PORT}" &>/dev/null && port_in_use=true
    fi
    if $port_in_use; then
        fail "Port $NGINX_PORT is already in use"
        (( errors++ ))
    else
        ok "Port $NGINX_PORT is available"
    fi

    # Check 5: Generated nginx.conf is syntactically valid
    if [[ ! -f "$GENERATED_NGINX" ]]; then
        cmd_init >/dev/null 2>&1
    fi
    if docker run --rm -v "$GENERATED_NGINX:/etc/nginx/nginx.conf:ro" \
        "$NGINX_IMAGE" nginx -t &>/dev/null; then
        ok "nginx.conf is syntactically valid"
    else
        fail "nginx.conf has syntax errors"
        (( errors++ ))
    fi

    echo ""
    if (( errors > 0 )); then
        fail "Validation failed with $errors error(s)"
        exit 1
    else
        ok "All checks passed"
    fi
}

# ─── DEPLOY ───
cmd_deploy() {
    info "Running init..."
    cmd_init

    info "Building Docker image..."
    docker build -t "$(yaml_get "$MANIFEST" "services.image")" "$SCRIPT_DIR"

    info "Bringing up the stack..."
    docker compose -f "$GENERATED_COMPOSE" up -d

    info "Waiting for health checks (timeout: 60s)..."
    read_manifest
    local elapsed=0
    while (( elapsed < 60 )); do
        if curl -sf "http://localhost:${NGINX_PORT}/healthz" >/dev/null 2>&1; then
            echo ""
            ok "Stack is healthy!"
            if [[ -n "$PYTHON_CMD" ]]; then
                curl -s "http://localhost:${NGINX_PORT}/healthz" | $PYTHON_CMD -m json.tool 2>/dev/null || \
                    curl -s "http://localhost:${NGINX_PORT}/healthz"
            else
                curl -s "http://localhost:${NGINX_PORT}/healthz"
            fi
            echo ""
            ok "SwiftDeploy stack is running on port $NGINX_PORT"
            return 0
        fi
        sleep 2
        (( elapsed += 2 ))
        printf "."
    done

    echo ""
    fail "Health check timed out after 60s"
    exit 1
}

# ─── PROMOTE ───
cmd_promote() {
    local target_mode="${1:-}"
    if [[ "$target_mode" != "canary" && "$target_mode" != "stable" ]]; then
        fail "Usage: swiftdeploy promote [canary|stable]"
        exit 1
    fi

    read_manifest
    local current_mode="$APP_MODE"

    if [[ "$current_mode" == "$target_mode" ]]; then
        warn "Already in $target_mode mode"
        return 0
    fi

    info "Promoting from $current_mode → $target_mode..."

    # Update mode in manifest.yaml in-place (both nested and top-level)
    sed -i "s/mode: $current_mode/mode: $target_mode/g" "$MANIFEST"

    # Regenerate docker-compose.yml with new MODE
    info "Regenerating docker-compose.yml..."
    read_manifest
    sed -e "s|{{APP_IMAGE}}|${APP_IMAGE}|g" \
        -e "s|{{APP_PORT}}|${APP_PORT}|g" \
        -e "s|{{MODE}}|${target_mode}|g" \
        -e "s|{{APP_VERSION}}|${APP_VERSION}|g" \
        -e "s|{{NGINX_IMAGE}}|${NGINX_IMAGE}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{NETWORK_NAME}}|${NETWORK_NAME}|g" \
        -e "s|{{NETWORK_DRIVER}}|${NETWORK_DRIVER}|g" \
        -e "s|{{RESTART_POLICY}}|${RESTART_POLICY}|g" \
        -e "s|{{VOLUME_NAME}}|${VOLUME_NAME}|g" \
        "$TEMPLATES_DIR/docker-compose.yml.tmpl" > "$GENERATED_COMPOSE"

    # Restart only the app service
    info "Restarting app service..."
    docker compose -f "$GENERATED_COMPOSE" up -d --no-deps --force-recreate app

    # Wait and confirm new mode
    info "Confirming new mode..."
    local elapsed=0
    while (( elapsed < 30 )); do
        local response
        response=$(curl -sf "http://localhost:${NGINX_PORT}/healthz" 2>/dev/null) || true
        if [[ -n "$response" ]]; then
            local live_mode
            if [[ -n "$PYTHON_CMD" ]]; then
                live_mode=$(echo "$response" | $PYTHON_CMD -c "import sys,json; print(json.load(sys.stdin).get('mode',''))" 2>/dev/null) || true
            else
                live_mode=$(echo "$response" | grep -o '"mode": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"/\1/') || true
            fi
            if [[ "$live_mode" == "$target_mode" ]]; then
                echo ""
                ok "Mode confirmed: $target_mode"
                if [[ -n "$PYTHON_CMD" ]]; then
                    echo "$response" | $PYTHON_CMD -m json.tool 2>/dev/null || echo "$response"
                else
                    echo "$response"
                fi

                # Show X-Mode header for canary
                if [[ "$target_mode" == "canary" ]]; then
                    echo ""
                    info "Response headers:"
                    curl -s -D- -o /dev/null "http://localhost:${NGINX_PORT}/healthz" 2>/dev/null | grep -i "x-mode" || true
                fi
                return 0
            fi
        fi
        sleep 2
        (( elapsed += 2 ))
        printf "."
    done

    echo ""
    fail "Could not confirm mode switch to $target_mode"
    exit 1
}

# ─── TEARDOWN ───
cmd_teardown() {
    local clean=false
    for arg in "$@"; do
        [[ "$arg" == "--clean" ]] && clean=true
    done

    info "Tearing down the stack..."

    if [[ -f "$GENERATED_COMPOSE" ]]; then
        docker compose -f "$GENERATED_COMPOSE" down -v --remove-orphans 2>/dev/null || true
    fi

    # Remove containers by name if still present
    docker rm -f swiftdeploy-app swiftdeploy-nginx 2>/dev/null || true

    # Remove the network
    read_manifest 2>/dev/null || true
    if [[ -n "${NETWORK_NAME:-}" ]]; then
        docker network rm "$NETWORK_NAME" 2>/dev/null || true
    fi

    ok "Containers, networks, and volumes removed"

    if $clean; then
        info "Cleaning generated config files..."
        rm -f "$GENERATED_COMPOSE" "$GENERATED_NGINX"
        ok "Generated configs deleted"
    fi
}

# ─── USAGE ───
usage() {
    cat <<EOF
${CYAN}SwiftDeploy${NC} — Declarative deployment tool

Usage: swiftdeploy <command> [options]

Commands:
  init                Parse manifest → generate nginx.conf + docker-compose.yml
  validate            Run 5 pre-flight checks
  deploy              Init + bring up stack + wait for health
  promote <mode>      Switch to canary or stable mode
  teardown [--clean]  Remove all containers/networks/volumes (--clean removes configs)

EOF
}

# ─── Main ───
case "${1:-}" in
    init)       cmd_init ;;
    validate)   cmd_validate ;;
    deploy)     cmd_deploy ;;
    promote)    cmd_promote "${2:-}" ;;
    teardown)   shift; cmd_teardown "$@" ;;
    *)          usage ;;
esac
